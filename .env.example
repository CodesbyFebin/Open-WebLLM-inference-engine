# Generate five separate values with: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=replace-with-64-hex-characters
HELLO_MIGRATOR_PASSWORD=replace-with-a-different-64-hex-value
HELLO_APP_PASSWORD=replace-with-a-different-64-hex-value
HELLO_WORKER_PASSWORD=replace-with-a-different-64-hex-value
AUTH_THROTTLE_PEPPER=replace-with-a-separate-64-hex-value

# NIM stays disabled unless the free entitlement has been verified separately.
# API_KEY is not needed in PostgreSQL multi-user mode. The browser signs in via
# the gateway session endpoint, and the bearer session remains in tab memory.
# NIM_ENABLED=false
