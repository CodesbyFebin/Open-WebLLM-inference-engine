{$SITE_DOMAIN} {
    encode zstd gzip
    @api path /api/*
    handle @api {
        reverse_proxy gateway:8080
    }
    handle /health {
        reverse_proxy gateway:8080
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        -Server
    }
    log {
        output stdout
        format json
    }
}
